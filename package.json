{
  "name": "dsh-web-search-chain",
  "version": "0.1.0",
  "description": "Pluggable web-search provider chain for DeepSeek Harness: free-tier API backends and keyless scraping behind one provider, with per-engine request budgets and automatic failover.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./engines": {
      "types": "./lib/engines.d.ts",
      "default": "./lib/engines.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/*.test.mjs\""
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "plugin",
    "web-search",
    "search-provider",
    "tavily",
    "langsearch",
    "bing",
    "searxng",
    "failover"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usr-com/dsh-web-search-chain.git"
  },
  "homepage": "https://github.com/usr-com/dsh-web-search-chain#readme",
  "bugs": {
    "url": "https://github.com/usr-com/dsh-web-search-chain/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-launch-environment": "*",
    "@deepseek-ai/dsh-web": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "volta": {
    "node": "24.18.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-launch-environment": "*",
    "@deepseek-ai/dsh-web": "*",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  }
}
