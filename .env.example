# dsh-web-search-chain 环境变量模板
#
# 使用方法：复制本文件为 .env 后填入真实密钥。
#   cp .env.example .env
# .env 已被 .gitignore 忽略，不会上传 GitHub —— 请只提交本模板。

# —— 各后端 API 密钥（推荐在此填写；插件按
#    engines.<id>.apiKey → apiKeys.<id> → 环境变量 顺序取值）——

# Tavily 搜索（https://tavily.com）
TAVILY_API_KEY=

# LangSearch 搜索（https://langsearch.com）
LANGSEARCH_API_KEY=

# DeepSeek 官方搜索（https://platform.deepseek.com）
DEEPSEEK_API_KEY=

# —— 可选：显式指定搜索 provider（仅当同时存在多个搜索 provider
#    竞争时才需要；默认安装即自动接管，无需设置）——
# DSH_WEB_SEARCH_PROVIDER=web-search-chain

# —— 可选：自定义密钥变量名（配合 config.engines.<id>.apiKeyEnv 使用）——
# 例：希望 LangSearch 从下面的变量取 key，则在插件 config 里配置：
#   engines:
#     langsearch:
#       apiKeyEnv: MY_LANGSEARCH_KEY
# MY_LANGSEARCH_KEY=