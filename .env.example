# dsh-web-search-chain 环境变量模板
#
# 使用方法：复制本文件为 .env 后填入真实密钥。
#   cp .env.example .env
# .env 已被 .gitignore 忽略，不会上传 GitHub —— 请只提交本模板。
#
# ⚠️ 但通常**更推荐**把密钥写进 harness 的凭据库：
#
#     $DSH_HOME/.credentials.yaml
#     refs:
#       TAVILY_API_KEY: tvly-xxxxxxxx
#
#   理由：那是 DSH 的 Models 页管理模型密钥的同一个文件，压过任何 .env，
#   而且**被热监听** —— 改完下一次搜索就生效，不用重启。
#   而 .env 只在启动时读一次，改完必须重启 harness。
#
# 取值优先级（插件侧）：engines.<id>.apiKey → apiKeys.<id> → harness 凭据 seam，
# 而该 seam 内部依次是：继承的进程环境 > $DSH_HOME/.credentials.yaml
# > <启动目录>/.env > $DSH_HOME/.env。
#
# ⚠️ 绝对不要在这里放 DSH_ 开头的变量（例如下面那条注释里的
#    DSH_WEB_SEARCH_PROVIDER）、DEEPSEEK_SEARCH_BASE_URL、代理变量或
#    SSL_CERT_* —— 它们只能由启动环境提供，出现在任何 .env 里都会让
#    harness 直接拒绝启动。

# —— 各后端 API 密钥 ——

# Tavily 搜索（https://tavily.com）
TAVILY_API_KEY=

# LangSearch 搜索（https://langsearch.com）
LANGSEARCH_API_KEY=

# DeepSeek 官方搜索（https://platform.deepseek.com）
# 通常不用填：在 DSH 的 Models 页填过的 key 已经存进凭据库，会自动复用。
# DEEPSEEK_API_KEY=

# —— 可选：显式指定搜索 provider ——
# 注意：这是引导变量，**只能**用系统环境变量设置，不能写在本文件里。
# 正常也不需要它：profile 里已把 web 行的 searchProvider 指向本插件。
# DSH_WEB_SEARCH_PROVIDER=web-search-chain

# —— 可选：自定义密钥变量名（配合 config.engines.<id>.apiKeyEnv 使用）——
# 例：希望 LangSearch 从下面的变量取 key，则在插件 config 里配置：
#   engines:
#     langsearch:
#       apiKeyEnv: MY_LANGSEARCH_KEY
# MY_LANGSEARCH_KEY=
